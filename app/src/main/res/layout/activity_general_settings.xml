<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/general_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_inset"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/page_horizontal_inset"
            android:paddingBottom="@dimen/page_bottom_inset">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/card_content_inset">

                    <LinearLayout
                        android:id="@+id/rowLanguage"
                        style="@style/Widget.Pulse.SettingsRow"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="@dimen/icon_large"
                            android:layout_height="@dimen/icon_large"
                            android:contentDescription="@string/language"
                            android:src="@drawable/ic_language" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:text="@string/language"
                            android:textAppearance="@style/TextAppearance.Pulse.Body" />
                        <TextView
                            android:id="@+id/tvLanguageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="140dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.Pulse.Supporting" />
                        <ImageView
                            android:layout_width="@dimen/icon_medium"
                            android:layout_height="@dimen/icon_medium"
                            android:layout_marginStart="@dimen/space_sm"
                            android:contentDescription="@string/language"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowTheme"
                        style="@style/Widget.Pulse.SettingsRow"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="@dimen/icon_large"
                            android:layout_height="@dimen/icon_large"
                            android:contentDescription="@string/theme"
                            android:src="@drawable/ic_theme" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:text="@string/theme"
                            android:textAppearance="@style/TextAppearance.Pulse.Body" />
                        <TextView
                            android:id="@+id/tvThemeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Pulse.Supporting" />
                        <ImageView
                            android:layout_width="@dimen/icon_medium"
                            android:layout_height="@dimen/icon_medium"
                            android:layout_marginStart="@dimen/space_sm"
                            android:contentDescription="@string/theme"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowTestUrl"
                        style="@style/Widget.Pulse.SettingsRow"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/test_url"
                            android:textAppearance="@style/TextAppearance.Pulse.Body" />
                        <TextView
                            android:id="@+id/tvTestUrlValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.Pulse.Supporting" />
                        <ImageView
                            android:layout_width="@dimen/icon_medium"
                            android:layout_height="@dimen/icon_medium"
                            android:layout_marginStart="@dimen/space_sm"
                            android:contentDescription="@string/test_url"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/card_content_inset">

                    <TextView android:id="@+id/btnQr" style="@style/SettingsRow" android:text="@string/text_to_qr" />
                    <View style="@style/RowDivider" />
                    <TextView android:id="@+id/btnLeak" style="@style/SettingsRow" android:text="@string/proxy_leak_check" />
                    <View style="@style/RowDivider" />
                    <TextView android:id="@+id/btnDnsCheck" style="@style/SettingsRow" android:text="@string/dns_check" />
                    <View style="@style/RowDivider" />
                    <TextView android:id="@+id/btnLatency" style="@style/SettingsRow" android:text="@string/latency_check" />
                    <View style="@style/RowDivider" />
                    <TextView android:id="@+id/btnBattery" style="@style/SettingsRow" android:text="@string/battery_optimization" />
                    <View style="@style/RowDivider" />
                    <TextView android:id="@+id/btnAbout" style="@style/SettingsRow" android:text="@string/about" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
