<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:focusable="true" android:focusableInTouchMode="true">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height" android:background="@color/background" app:menu="@menu/menu_config_list" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/profiles" />
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Pulse.SearchInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height"
        android:layout_marginHorizontal="@dimen/page_horizontal_inset"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_sm">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:hint="@string/search_nodes"
            android:includeFontPadding="false"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingTop="@dimen/space_xxs"
            android:paddingBottom="0dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_body" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/no_profile" android:textColor="@color/text_secondary" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="@dimen/list_content_inset" android:paddingBottom="88dp" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="@dimen/space_xl" android:contentDescription="@string/add" android:src="@drawable/ic_add" app:backgroundTint="@color/action_dark" app:tint="@color/action_on_dark" />
    </FrameLayout>
</LinearLayout>
