<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_content_inset"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/dialog_content_inset"
    android:paddingBottom="@dimen/space_xs">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialogInputLayout"
        style="@style/Widget.Pulse.DialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:minHeight="@dimen/dialog_input_min_height"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_body" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
