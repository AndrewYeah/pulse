<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_inset"
        android:paddingTop="@dimen/space_2xl"
        android:paddingEnd="@dimen/page_horizontal_inset"
        android:paddingBottom="@dimen/page_bottom_inset">

        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_language"
                app:tint="@color/colorPrimary" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/onboarding_title"
                android:textAppearance="@style/TextAppearance.Pulse.OnboardingTitle"
                android:textStyle="bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/onboarding_subtitle"
                android:textAppearance="@style/TextAppearance.Pulse.OnboardingSubtitle" />

        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                style="@style/Widget.Pulse.Card">

                <RadioGroup
                    android:id="@+id/languageOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionEnglish"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_english" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionChinese"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_simplified_chinese" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionRussian"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_russian" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionPersian"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_persian" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionAzerbaijani"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_azerbaijani" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/optionArabic"
                        style="@style/Widget.Pulse.LanguageOption"
                        android:text="@string/onboarding_arabic" />
                </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/onboarding_continue"
            style="@style/Widget.Pulse.Button" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
