<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SubPageText" parent="android:style/Widget.TextView">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SubPageEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="ThemeOverlay.Pulse.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_window_background</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>

    <style name="Widget.Pulse.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner_container</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Pulse.ListCard" parent="Widget.Pulse.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
    </style>

    <style name="Widget.Pulse.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@color/background</item>
        <item name="titleTextAppearance">@style/TextAppearance.Pulse.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Pulse.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Pulse.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Pulse.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Pulse.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Pulse.OnboardingTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_onboarding_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.Pulse.OnboardingSubtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_onboarding_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Pulse.LanguageOption" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/onboarding_option_height</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="buttonTint">@color/colorPrimary</item>
    </style>

    <style name="Widget.Pulse.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.Pulse.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">@dimen/corner_container</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Pulse.SegmentedButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
    </style>

    <style name="Widget.Pulse.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
        <item name="boxStrokeColor">@color/search_box_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Pulse.SearchInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_search</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_search</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_search</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_search</item>
        <item name="boxStrokeColor">@color/search_box_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_thin</item>
        <item name="hintEnabled">false</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconMode">clear_text</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.Pulse.DialogInput" parent="Widget.Pulse.Input">
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Pulse.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
        <item name="boxStrokeColor">@color/search_box_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Pulse.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_row_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/space_xs</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsRow" parent="Widget.Pulse.SettingsRow">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawablePadding">@dimen/space_sm</item>
    </style>

    <style name="Widget.Pulse.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_row_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_thin</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
